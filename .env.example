# Structura.AI Environment Variables

# Application
APP_NAME=Structura.AI
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Database: PostgreSQL (production / docker-compose) or SQLite fallback (local dev)
# Para PostgreSQL: postgresql+asyncpg://structura_user:structura_secure_pass_2026@localhost:5432/structura_db
# Para SQLite local instantâneo: sqlite+aiosqlite:///./structura_ai.db
DATABASE_URL=sqlite+aiosqlite:///./structura_ai.db

# Google Gemini API Key (Modelos Gratuitos: gemini-2.5-flash ou gemini-1.5-flash)
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
